GARMIN_EMAIL=
GARMIN_PASSWORD=
# Absolute directory for Garmin auth files. Compose uses /data/garmin.
GARMIN_TOKEN_DIR=
# Optional first-pull history start date in YYYY-MM-DD format.
GARMIN_HISTORY_START=
# Required for Anthropic calls. Check configuration with
# `uv run training-season-claude check`.
ANTHROPIC_API_KEY=
# Optional model id for Sunday plan generation. Default: claude-opus-5-5.
CLAUDE_PLAN_MODEL=
# Optional effort. Default: medium. Allowed: low, medium, high, xhigh, max, none.
CLAUDE_PLAN_EFFORT=
# Optional model id for chat turns. Default: claude-sonnet-5-5.
CLAUDE_CHAT_MODEL=
# Optional effort. Default: medium. Allowed: low, medium, high, xhigh, max, none.
CLAUDE_CHAT_EFFORT=
# Optional absolute path to the coaching instruction file. Empty uses the bundled
# Portuguese example. In Docker, use the path inside the container. See
# docs/coach-instruction.md. Check with `uv run training-season-instruction check`.
COACH_INSTRUCTION_PATH=
APP_PASSWORD=
BREVO_API_KEY=
BACKUP_EMAIL_FROM=
BACKUP_EMAIL_TO=
TZ=
# Absolute path to the SQLite file. docker-compose.yml sets it to
# /data/training-season.db inside the container. Set it yourself for runs outside Docker.
DATABASE_PATH=
