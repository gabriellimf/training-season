GARMIN_EMAIL=
GARMIN_PASSWORD=
# Absolute directory for Garmin auth files. Compose uses /data/garmin.
GARMIN_TOKEN_DIR=
# Optional first-pull history start date in YYYY-MM-DD format.
GARMIN_HISTORY_START=
ANTHROPIC_API_KEY=
APP_PASSWORD=
BREVO_API_KEY=
BACKUP_EMAIL_FROM=
BACKUP_EMAIL_TO=
TZ=
# Absolute path to the SQLite file. docker-compose.yml sets it to
# /data/training-season.db inside the container. Set it yourself for runs outside Docker.
DATABASE_PATH=
